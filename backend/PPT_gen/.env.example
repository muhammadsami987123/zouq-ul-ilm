# Google AI Studio API Configuration
# Get your API keys from: https://aistudio.google.com/app/apikey
# You can use multiple keys for better rate limiting and reliability

# Primary API Key (Required)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Additional API Keys (Optional - for rate limiting)
API_KEY_1=your_second_api_key_here
API_KEY_2=your_third_api_key_here
API_KEY_3=your_fourth_api_key_here

# Processing Configuration
MAX_PAGES_PER_DOCUMENT=50
RATE_LIMIT_DELAY=2.0
MAX_RETRIES=3

# AI Content Generation Settings
DEFAULT_TEMPERATURE=0.4
DEFAULT_TOP_K=50
DEFAULT_TOP_P=0.9
MAX_OUTPUT_TOKENS=800

# Content Quality Thresholds
MIN_BULLET_LENGTH=50
MAX_BULLET_LENGTH=200
MIN_WORD_COUNT=8
SIMILARITY_THRESHOLD=0.7

# Directory Configuration
TEMPLATES_DIR=templates
OUTPUT_DIR=output
LOGS_DIR=logs
TEMP_DIR=temp

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Development Settings
DEBUG_MODE=false
ENABLE_CACHING=true
